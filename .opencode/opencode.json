{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "postgres-app": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://admin:test1234@127.0.0.1:5432/app_db"
      ],
      "enabled": true
    },
    "postgres-api": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://admin:test1234@127.0.0.1:5432/api_db"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "--yes",
        "@playwright/mcp",
        "--headless",
        "--isolated",
        "--browser",
        "chromium",
        "--viewport-size",
        "1440x900"
      ],
      "enabled": true,
      "timeout": 60000
    }
  }
}
